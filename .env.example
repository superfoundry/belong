# Copy to .env (git-ignored) and fill in. The server reads it at startup.

# Personal agent in the demo: OpenAI is used when this is set.
OPENAI_API_KEY=
# Optional: which OpenAI model (default gpt-5)
# OPENAI_MODEL=gpt-5
# Optional: the model that writes simulated people's chat replies in the demo (default gpt-5-mini)
# OPENAI_CHAT_MODEL=gpt-5-mini

# Optional: force an agent: openai | claude | rules
# BELONG_AGENT=openai
